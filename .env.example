# =============================================================================
# CPSForge Environment Configuration Example
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------
# PLC CONNECTION
# -----------------------------------------------------------------------
# Real Siemens PLC host. Must be reachable from this machine.
CPSFORGE_PLC_HOST=192.168.0.1
CPSFORGE_PLC_RACK=0
CPSFORGE_PLC_SLOT=1

# -----------------------------------------------------------------------
# LIVE WRITE SAFETY FLAG
# -----------------------------------------------------------------------
# Set to "true" ONLY when you intend to issue live writes to the PLC.
# Dry-run mode is the default (CPSFORGE_LIVE_WRITES=false).
# This flag must be explicitly set; it is never assumed true.
CPSFORGE_LIVE_WRITES=false

# -----------------------------------------------------------------------
# LLM PROVIDER (Local OpenAI-Compatible — LM Studio)
# -----------------------------------------------------------------------
# CPSForge uses a local model server with an OpenAI-compatible API.
# No cloud API keys are required. Start LM Studio and load a model.

# LM Studio local server (default)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=qwen2-7b-instruct

# -----------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------
CPSFORGE_LOG_LEVEL=INFO
CPSFORGE_LOG_DIR=data/raw

# -----------------------------------------------------------------------
# DATA PATHS
# -----------------------------------------------------------------------
CPSFORGE_DATA_DIR=data
CPSFORGE_RAW_DIR=data/raw
CPSFORGE_PROCESSED_DIR=data/processed
CPSFORGE_REPLAYS_DIR=data/replays
