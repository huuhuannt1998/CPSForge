// MANTIS — Scene 8: Buffer Station
// Buffer and separate up to five boxes.
// DB17: I/O mapping

FUNCTION_BLOCK "FB_BufferStation"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.2

VAR
    Sensor1   : BOOL;  // 0.0
    _pad0     : BYTE;
    Sensor2   : BOOL;  // 2.0
    _pad1     : BYTE;
    Sensor3   : BOOL;  // 4.0
    _pad2     : BYTE;
    Sensor4   : BOOL;  // 6.0
    _pad3     : BYTE;
    Sensor5   : BOOL;  // 8.0
    _pad4     : BYTE;
    AtExit    : BOOL;  // 10.0
    _pad5     : BYTE;
    Conveyor  : BOOL;  // 12.0
    _pad6     : BYTE;
    Stopper1  : BOOL;  // 14.0
    _pad7     : BYTE;
    Stopper2  : BOOL;  // 16.0
    _pad8     : BYTE;
    Emitter   : BOOL;  // 18.0
    _pad9     : BYTE;
    Remover   : BOOL;  // 20.0
    _pad10    : BYTE;
    
    iState     : INT := 0;
    BoxCount   : INT := 0;
    BUFFER_MAX : INT := 5;
END_VAR

BEGIN
    // Always-on infrastructure
    Conveyor := TRUE;
    Emitter := TRUE;
    Remover := TRUE;
    
    // Count boxes by number of occupied sensor positions
    BoxCount := 0;
    IF Sensor1 THEN BoxCount := BoxCount + 1; END_IF;
    IF Sensor2 THEN BoxCount := BoxCount + 1; END_IF;
    IF Sensor3 THEN BoxCount := BoxCount + 1; END_IF;
    IF Sensor4 THEN BoxCount := BoxCount + 1; END_IF;
    IF Sensor5 THEN BoxCount := BoxCount + 1; END_IF;
    
    // Simple pass-through with stoppers open
    // Stopper FALSE = retracted (passing), TRUE = extended (blocking)
    // Let boxes flow freely — Remover handles cleanup at exit
    CASE iState OF
        0: // Accumulate: both stoppers open, let boxes fill buffer
            Stopper1 := FALSE;
            Stopper2 := FALSE;
            IF BoxCount >= BUFFER_MAX THEN
                // Buffer full — close entry stopper to stop more
                Stopper1 := TRUE;
                iState := 1;
            END_IF;
            
        1: // Buffer full — hold and release one at a time
            Stopper1 := TRUE;   // Block new arrivals
            Stopper2 := FALSE;  // Let exit box through
            IF AtExit THEN
                iState := 2;
            END_IF;
            
        2: // Wait for exit to clear, then go back to accumulate
            Stopper1 := TRUE;
            Stopper2 := FALSE;
            IF NOT AtExit THEN
                iState := 0;
            END_IF;
    END_CASE;
END_FUNCTION_BLOCK
