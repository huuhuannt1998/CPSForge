// MANTIS — Scene 3: Filling Tank (Timers)
// Fill and empty a tank using timers with two discrete level sensors.
// DB12: I/O mapping

FUNCTION_BLOCK "FB_FillingTank"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1

VAR
    LevelHigh  : BOOL;   // 0.0
    _pad0      : BYTE;
    LevelLow   : BOOL;   // 2.0
    _pad1      : BYTE;
    FillValve  : BOOL;   // 4.0
    _pad2      : BYTE;
    DrainValve : BOOL;   // 6.0
    _pad3      : BYTE;
    
    Filling    : BOOL := TRUE;
END_VAR

BEGIN
    // Fill until high, then drain until low
    IF Filling THEN
        FillValve := TRUE;
        DrainValve := FALSE;
        IF LevelHigh THEN
            Filling := FALSE;
        END_IF;
    ELSE
        FillValve := FALSE;
        DrainValve := TRUE;
        IF LevelLow THEN
            Filling := TRUE;
        END_IF;
    END_IF;
END_FUNCTION_BLOCK
