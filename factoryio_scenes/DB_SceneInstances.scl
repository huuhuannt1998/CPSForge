// =============================================================================
// MANTIS — Instance Data Blocks for all 21 Factory I/O Scene FBs
//
// After importing this file in TIA Portal, you MUST set the DB numbers:
//   Right-click each DB → Properties → General → Number
//   Assign the DB numbers according to the table below.
//
// DB Number Assignments:
//   DB10 = FB_FromAtoB_DB
//   DB11 = FB_FromAtoB_SR_DB
//   DB12 = FB_FillingTank_DB
//   DB13 = FB_QueueItems_DB
//   DB14 = FB_Assembler_DB
//   DB15 = FB_AssemblerAnalog_DB
//   DB16 = FB_Warehouse_DB
//   DB17 = FB_BufferStation_DB
//   DB18 = FB_ConvergeStation_DB
//   DB19 = FB_ElevatorAdvanced_DB
//   DB20 = FB_ElevatorBasic_DB
//   DB21 = FB_LevelControl_DB
//   DB22 = FB_Palletizer_DB
//   DB23 = FB_PickPlaceBasic_DB
//   DB24 = FB_PickPlaceXYZ_DB
//   DB25 = FB_ProductionLine_DB
//   DB26 = FB_SeparatingStation_DB
//   DB27 = FB_SortingHeightAdv_DB
//   DB28 = FB_SortingHeightBasic_DB
//   DB29 = FB_SortingWeight_DB
//   DB30 = FB_SortingStation_DB
// =============================================================================

// Scene 1: From A to B → DB10
DATA_BLOCK "FB_FromAtoB_DB"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.1
NON_RETAIN
"FB_FromAtoB"
BEGIN
END_DATA_BLOCK

