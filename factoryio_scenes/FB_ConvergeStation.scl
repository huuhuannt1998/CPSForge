// MANTIS — Scene 9: Converge Station
// Converge two paths into a single output conveyor.
// DB18: I/O mapping

FUNCTION_BLOCK "FB_ConvergeStation"
{ S7_Optimized_Access := 'FALSE' }
VERSION : 0.2

VAR
    SensorLeft    : BOOL;  // 0.0
    _pad0         : BYTE;
    SensorRight   : BOOL;  // 2.0
    _pad1         : BYTE;
    SensorMerge   : BOOL;  // 4.0
    _pad2         : BYTE;
    AtExit        : BOOL;  // 6.0
    _pad3         : BYTE;
    ConveyorLeft  : BOOL;  // 8.0
    _pad4         : BYTE;
    ConveyorRight : BOOL;  // 10.0
    _pad5         : BYTE;
    ConveyorOut   : BOOL;  // 12.0
    _pad6         : BYTE;
    Emitter1      : BOOL;  // 14.0
    _pad7         : BYTE;
    Emitter2      : BOOL;  // 16.0
    _pad8         : BYTE;
    Remover       : BOOL;  // 18.0
    _pad9         : BYTE;
    
    Priority : BOOL := FALSE;  // FALSE=left first, TRUE=right first
END_VAR

BEGIN
    // Always-on infrastructure
    ConveyorOut := TRUE;
    Remover := TRUE;
    Emitter1 := TRUE;
    Emitter2 := TRUE;
    
    // Default: run BOTH input conveyors so boxes reach sensors
    ConveyorLeft := TRUE;
    ConveyorRight := TRUE;
    
    IF SensorMerge THEN
        // Merge point occupied — stop both inputs, toggle priority for next
        ConveyorLeft := FALSE;
        ConveyorRight := FALSE;
        Priority := NOT Priority;
    ELSIF SensorLeft AND SensorRight THEN
        // Both sides have a box — let priority side through, hold the other
        IF Priority THEN
            ConveyorLeft := FALSE;   // Hold left, let right advance
        ELSE
            ConveyorRight := FALSE;  // Hold right, let left advance
        END_IF;
    END_IF;
    // If only one side has a box, both conveyors stay on → box advances freely
END_FUNCTION_BLOCK
